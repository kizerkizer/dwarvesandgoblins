{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "lib": ["DOM", "ES2020"],
        "types": ["@webgpu/types", "bun"],
        "paths": {
                "@client/*": ["./src/client/*"],
                "@server/*": ["./src/server/*"],
                "@common/*": ["./src/common/*"]
        }
    }
}